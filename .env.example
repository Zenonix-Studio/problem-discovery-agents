# Copy this file to .env for future local runs. Do not commit .env or real keys.
# Tests and the configuration test fixtures do not require live credentials.
PDA_GITHUB_TOKEN=
PDA_TAVILY_API_KEY=
PDA_LLM_API_KEY=

# Initial shared-model defaults. These can be overridden without editing code.
PDA_LLM_PROVIDER=openai
PDA_LLM_MODEL=gpt-5.4-mini
PDA_LLM_REASONING_EFFORT=medium

# Optional OpenAI-compatible endpoint. Leave blank to use the provider default.
PDA_LLM_BASE_URL=
PDA_LOG_LEVEL=INFO
PDA_RECORD_PROVIDER_USAGE=true
